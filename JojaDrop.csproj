<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.4.0</Version>
    <RootNamespace>JojaDrop</RootNamespace>
    <AssemblyName>JojaDrop</AssemblyName>
    <ModFolderName>JojaDrop</ModFolderName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.4.0" />
    <None Update="assets\upgrade-button.png" CopyToOutputDirectory="PreserveNewest" />
    <None Update="assets\wheel\wheel_arrow.png" CopyToOutputDirectory="PreserveNewest" />
    <None Update="assets\wheel\wheel_center.png" CopyToOutputDirectory="PreserveNewest" />
    <None Update="assets\wheel\wheel_frame.png" CopyToOutputDirectory="PreserveNewest" />
    <None Update="manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Tests/**/*.cs" />
    <None Remove="Tests/**" />
  </ItemGroup>
</Project>
